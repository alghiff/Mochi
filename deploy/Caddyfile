# Caddy untuk Mochi di belakang Cloudflare Tunnel.
#
# TLS publik ditangani Cloudflare di edge, jadi Caddy cukup melayani HTTP
# di localhost. Cloudflared menghubungi http://127.0.0.1:8080.
#
# Pasang ke /etc/caddy/Caddyfile lalu:
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

:8080 {
	bind 127.0.0.1

	# Caddy meneruskan Host asli dan menambahkan alamat peer sebagai entri
	# terakhir X-Forwarded-For. Server memakai entri itu hanya kalau peer
	# ada di TRUSTED_PROXIES (default: loopback).
	reverse_proxy 127.0.0.1:8000
}
