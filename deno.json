{
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-write --allow-env --unstable-kv server.js",
    "dev": "deno run --watch --allow-net --allow-read --allow-write --allow-env --unstable-kv server.js",
    "cloud": "deno run --allow-read --allow-write --allow-env --unstable-kv scripts/cloud.js",
    "check": "deno check server.js src/main.js scripts/cloud.js",
    "test": "deno test --allow-net --allow-read --allow-write --allow-env --allow-run --unstable-kv tests/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "verify": "deno lint && deno fmt --check && deno check server.js src/main.js scripts/cloud.js"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "README.md"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
